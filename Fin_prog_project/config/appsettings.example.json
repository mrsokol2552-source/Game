{
  "app": {
    "environment": "dev",
    "timezone": "Asia/Yakutsk",
    "poll_interval_minutes": 30,
    "output_snapshot_path": "data/exports/latest_market_snapshot.json",
    "evidence_schema_path": "config/evidence.schema.json"
  },
  "source": {
    "provider": "moex_iss",
    "base_url": "https://iss.moex.com/iss",
    "timeout_seconds": 20,
    "iss_meta_off": true,
    "user_agent": "FinProgProject/0.1"
  },
  "triggers": {
    "comparison_mode": "previous_poll",
    "price_move_threshold_pct": 1.0,
    "volatility_ratio_threshold": 2.0,
    "cooldown_minutes": 60
  },
  "codex": {
    "enabled": false,
    "working_directory": "data/evidence",
    "prompt_template_path": "supplements/prompts/codex_market_note_template.txt",
    "runner": "codex exec",
    "timeout_seconds": 120
  },
  "delivery": {
    "primary": "yandex_messenger_web",
    "fallback": "local_file",
    "persist_profile_dir": "data/browser-profile"
  },
  "instruments": [
    {
      "id": "usd_rub_tom",
      "label": "USD/RUB TOM",
      "enabled": true,
      "kind": "fx",
      "resolution": {
        "query": "USDRUB_TOM",
        "prefer_exact_shortname": "USDRUB_TOM",
        "type": "currency",
        "group": "currency_selt",
        "primary_boardid": "CETS",
        "only_traded": true
      },
      "snapshot": {
        "engine": "currency",
        "market": "selt",
        "board": "CETS"
      },
      "pricing": {
        "current_price_priority": ["LAST", "MARKETPRICE", "WAPRICE", "OPEN"],
        "previous_price_priority": ["PREVPRICE", "PREVWAPRICE"]
      }
    },
    {
      "id": "cny_rub_tom",
      "label": "CNY/RUB TOM",
      "enabled": true,
      "kind": "fx",
      "resolution": {
        "query": "CNYRUB_TOM",
        "prefer_exact_secid": "CNYRUB_TOM",
        "prefer_exact_shortname": "CNYRUB_TOM",
        "type": "currency",
        "group": "currency_selt",
        "primary_boardid": "CETS",
        "only_traded": true
      },
      "snapshot": {
        "engine": "currency",
        "market": "selt",
        "board": "CETS"
      },
      "pricing": {
        "current_price_priority": ["LAST", "MARKETPRICE", "WAPRICE", "OPEN"],
        "previous_price_priority": ["PREVPRICE", "PREVWAPRICE"]
      }
    },
    {
      "id": "gold_rub_tom",
      "label": "GLD/RUB TOM",
      "enabled": true,
      "kind": "metal",
      "resolution": {
        "query": "GLDRUB_TOM",
        "prefer_exact_secid": "GLDRUB_TOM",
        "prefer_exact_shortname": "GLDRUB_TOM",
        "type": "gold_metal",
        "group": "currency_metal",
        "primary_boardid": "CETS",
        "only_traded": true
      },
      "snapshot": {
        "engine": "currency",
        "market": "selt",
        "board": "CETS"
      },
      "pricing": {
        "current_price_priority": ["LAST", "MARKETPRICE", "WAPRICE", "OPEN"],
        "previous_price_priority": ["PREVPRICE", "PREVWAPRICE"]
      }
    },
    {
      "id": "brent_front",
      "label": "Brent Front Month",
      "enabled": true,
      "kind": "futures",
      "resolution": {
        "query": "BR",
        "type": "futures",
        "group": "futures_forts",
        "primary_boardid": "RFUD",
        "shortname_prefix": "BR-",
        "only_traded": true
      },
      "snapshot": {
        "engine": "futures",
        "market": "forts",
        "board": "RFUD"
      },
      "pricing": {
        "current_price_priority": ["LAST", "SETTLEPRICE", "OPEN"],
        "previous_price_priority": ["PREVPRICE", "PREVSETTLEPRICE"]
      }
    }
  ]
}
