{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinProg Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at_utc",
    "source",
    "event",
    "instruments"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "config_name"],
      "properties": {
        "provider": { "type": "string" },
        "config_name": { "type": "string" },
        "snapshot_path": { "type": "string" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "trigger_type",
        "comparison_mode",
        "poll_interval_minutes",
        "thresholds"
      ],
      "properties": {
        "id": { "type": "string" },
        "trigger_type": {
          "type": "string",
          "enum": ["price_move", "volatility_spike", "manual"]
        },
        "comparison_mode": { "type": "string" },
        "poll_interval_minutes": { "type": "integer", "minimum": 1 },
        "cooldown_applied": { "type": "boolean" },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["price_move_pct", "volatility_ratio"],
          "properties": {
            "price_move_pct": { "type": "number" },
            "volatility_ratio": { "type": "number" }
          }
        }
      }
    },
    "instruments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/instrument" }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string" },
        "horizon_minutes": { "type": "integer", "minimum": 1 },
        "predicted_delta_pct": { "type": "number" },
        "predicted_price": { "type": "number" },
        "confidence_label": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "r2": { "type": "number" },
            "mae_pct": { "type": "number" }
          }
        }
      }
    },
    "codex": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt_template": { "type": "string" },
        "prompt_path": { "type": "string" }
      }
    }
  },
  "$defs": {
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "resolved_security",
        "price_snapshot",
        "analytics"
      ],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "resolved_security": {
          "type": "object",
          "additionalProperties": false,
          "required": ["query", "secid", "shortname", "board", "engine", "market"],
          "properties": {
            "query": { "type": "string" },
            "secid": { "type": "string" },
            "shortname": { "type": "string" },
            "name": { "type": "string" },
            "type": { "type": "string" },
            "group": { "type": "string" },
            "board": { "type": "string" },
            "engine": { "type": "string" },
            "market": { "type": "string" }
          }
        },
        "price_snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current_price",
            "current_price_field",
            "previous_price",
            "previous_price_field"
          ],
          "properties": {
            "current_price": { "type": ["number", "null"] },
            "current_price_field": { "type": ["string", "null"] },
            "previous_price": { "type": ["number", "null"] },
            "previous_price_field": { "type": ["string", "null"] },
            "bid": { "type": ["number", "null"] },
            "offer": { "type": ["number", "null"] },
            "open": { "type": ["number", "null"] },
            "high": { "type": ["number", "null"] },
            "low": { "type": ["number", "null"] },
            "exchange_time": { "type": ["string", "null"] },
            "system_time": { "type": ["string", "null"] }
          }
        },
        "analytics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["delta_pct"],
          "properties": {
            "delta_pct": { "type": ["number", "null"] },
            "log_return": { "type": ["number", "null"] },
            "vol_short": { "type": ["number", "null"] },
            "vol_long": { "type": ["number", "null"] },
            "vol_ratio": { "type": ["number", "null"] }
          }
        }
      }
    }
  }
}
